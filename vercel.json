{
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/jobs/flag-overdue", "schedule": "17 6 * * *" }]
}
