# ─────────────────────────────────────────────────────────────────────────────
# Hermite Labs — environment variables
# Copy to `.env` for local dev and paste into Vercel → Settings → Env Vars for prod.
# See docs/SETUP_GUIDE.md for where each value comes from. NEVER commit a real .env.
# Variables prefixed VITE_ are exposed to the browser — keep secrets OUT of those.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
# Production: APP_URL=https://flow.hermitelabs.com (see docs/DOMAINS.md).
# hermitelabs.com serves the Hermite Labs parent site from the same deployment.
NODE_ENV=development
APP_URL=http://localhost:3000               # server-side origin for links in email/PDF
VITE_APP_URL=http://localhost:3000          # same origin, exposed to the browser
# Gates /api/jobs/* and the detailed /api/health output. REQUIRED for the daily
# overdue sweep: /api/jobs/flag-overdue denies every caller when this is unset
# (it fails closed rather than opening a cross-tenant write to the internet).
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET` for the
# scheduled invocation declared in vercel.json.
CRON_SECRET=                                # long random string

# ── Clerk (authentication) ──────────────────────────────────────────────────
# From the Clerk dashboard → API keys (https://dashboard.clerk.com).
# The publishable key is safe for the browser; the secret key is server-only.
CLERK_SECRET_KEY=                           # server only — verifies session tokens + user lookups
VITE_CLERK_PUBLISHABLE_KEY=                 # safe for the browser (pk_test_… / pk_live_…)

# ── Development sign-in (local only — NOT authentication) ───────────────────
# Set both to 1 to run the product without a Clerk instance: the login page
# shows a form that takes an email and no password, and the server accepts that
# identity as-is. Useful for local development and seeding; useless as security.
#
# Guards: DEV_AUTH is ignored when NODE_ENV=production, and a production server
# with it set refuses to start (server/auth/devAuth.ts). Clerk always wins — with
# VITE_CLERK_PUBLISHABLE_KEY set, VITE_DEV_AUTH does nothing.
#
# NEVER set either of these in a deployed environment.
DEV_AUTH=                                   # server: 1 accepts dev sign-in tokens
VITE_DEV_AUTH=                              # browser: 1 renders the dev sign-in form

# ── Supabase Postgres (database) ────────────────────────────────────────────
# Data lives in Supabase Postgres; auth is handled by Clerk (above).
# If you used Vercel's Supabase integration these are auto-provisioned as
# POSTGRES_URL (pooled) and POSTGRES_URL_NON_POOLING (direct); the server reads
# either naming.
DATABASE_URL=                               # pooled (Transaction mode) — runtime  (= POSTGRES_URL)
DIRECT_URL=                                 # direct (non-pooled) — migrations only (= POSTGRES_URL_NON_POOLING)

# ── Resend (email) ──────────────────────────────────────────────────────────
# NB: the code reads RESEND_FROM_EMAIL (server/emailService.ts). The old
# EMAIL_FROM name was documented here but never read — don't reintroduce it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=HermiteFlow <billing@hermitelabs.com>   # display name + verified sender

# ── HermiteFlow public API (used by the MCP server and external integrations) ──
# Consumed by mcp/ and scripts/connect.mjs. The legacy INVOICEFLOW_* names are
# still honoured as a fallback during the cutover — see mcp/src/index.ts.
# TODO(hermite): remove the INVOICEFLOW_* fallback after env cutover
HERMITE_FLOW_API_URL=http://localhost:3000  # your site origin
HERMITE_FLOW_API_KEY=                       # an API key (ifk_live_… / ifk_test_…) from the dashboard

# ── Storage proxy (required for invoice PDF generation) ─────────────────────
# server/storage.ts uploads generated invoice PDFs through a hosted storage
# proxy. Without these, POST /api/v1/invoices/:id/pdf fails with
# "Storage proxy credentials missing" — everything else keeps working.
# This is vendor scaffolding inherited from the original generator; see
# MIGRATION-AUDIT.md § 5 for the recommendation to replace it with direct S3
# or Supabase Storage.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Analytics (optional) ────────────────────────────────────────────────────
# Injected by client/src/analytics.ts. Leave either blank to disable — no script
# tag is emitted at all in that case.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# NOT YET IMPLEMENTED — the variables below are read by NO code in this repo.
# They describe planned integrations (see docs/PRODUCT_PLAN.md). Setting them
# does nothing today; they are kept here as a roadmap marker.
# ─────────────────────────────────────────────────────────────────────────────

# ── Polar.sh (SaaS subscriptions) — planned ─────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox                        # sandbox | production
POLAR_PRODUCTS_JSON={"pro_monthly":"","pro_annual":"","business_monthly":"","business_annual":""}

# ── Stripe (invoice payments) — planned ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Observability — planned ─────────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Storage — planned ───────────────────────────────────────────────────────
# Bucket name is business-domain ("invoices"), not branding — do not rename.
SUPABASE_STORAGE_BUCKET=invoices
